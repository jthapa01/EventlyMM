###
# group: Tickets
# @name Get Ticket
GET {{api_url}}/tickets/{{ticketId}}
Content-Type: application/json
Authorization: Bearer {{access_token}}

###
# group: Tickets
# @name Get Ticket By Code
GET {{api_url}}/tickets/code/{{ticketCode}}
Content-Type: application/json
Authorization: Bearer {{access_token}}

###
# group: Tickets
# @name Get Tickets For Order
GET {{api_url}}/tickets/order/{{orderId}}
Content-Type: application/json
Authorization: Bearer {{access_token}}

###
# group: Carts
# @name Add To Cart
PUT {{api_url}}/carts/add
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "customerId": "{{customerId}}",
  "ticketTypeId": "{{ticketTypeId}}",
  "quantity": 5
}

###
# group: Orders
# @name Create Order
POST {{api_url}}/orders
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "customerId": "{{customerId}}"
}

###
# group: Orders
# @name Get Orders
GET {{api_url}}/orders
Content-Type: application/json
Authorization: Bearer {{access_token}}

###
# group: Orders
# @name Get Order
GET {{api_url}}/orders/{{orderId}}
Content-Type: application/json