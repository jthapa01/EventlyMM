###
# group: RefreshToken
POST {{keycloak_url}}/realms/evently/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=refresh_token&client_id=evently-public-client&refresh_token={{refresh_token}}


###
# group: ClientCredentials
POST {{keycloak_url}}/realms/evently/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&client_id=evently-confidential-client&client_secret={{client_secret}}&scope=openid

